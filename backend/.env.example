# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pyjwxsg.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.pyjwxsg.mongodb.net/portfolio?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS & Frontend URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
